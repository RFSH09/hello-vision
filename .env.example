# Copy to .env (git-ignored) or set in the systemd unit. Never commit real values.
VISION_FRIDGE_ID=demo-fridge
VISION_BACKEND_URL=https://backend.example.invalid
VISION_HMAC_SECRET=change-me
VISION_SESSIONS_ROOT=/var/lib/hello-vision/sessions
VISION_EVIDENCE_ROOT=/var/lib/hello-vision/evidence
VISION_QUEUE_ROOT=/var/lib/hello-vision/queue
VISION_RETENTION_DAYS=30
# Required to open the review UI; leave empty only on a closed network
VISION_REVIEW_TOKEN=
# Optional: module:function returning a SessionAnalyzer (default: synthetic demo pipeline)
VISION_ANALYZER=sim.pipeline:build_demo_analyzer
# REQUIRED: YuNet face model (python tools/fetch_face_model.py) and optional always-blurred regions
VISION_FACE_MODEL=/var/lib/hello-vision/models/face_detection_yunet_2023mar.onnx
VISION_BLUR_REGIONS=
